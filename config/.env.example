# Salin file ini menjadi config/.env lalu isi nilainya. config/.env JANGAN di-commit.
# Lingkungan aplikasi: 'development' menampilkan error PHP, 'production' menyembunyikan error dan mewajibkan ganti password default staf.
APP_ENV=development

# Kunci rahasia HMAC token pesanan (wajib diganti sebelum dipakai).
# Hasilkan secret acak 64 karakter hex: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=GANTI_DENGAN_SECRET_ACAK_MIN_32_KARAKTER

# Konfigurasi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=QuickBrew
DB_USER=postgres
DB_PASS=

# Kredensial Midtrans Core API (Sandbox: SB-Mid-... / Production: Mid-...)
MIDTRANS_SERVER_KEY=SB-Mid-server-GANTI_DENGAN_SERVER_KEY_MIDTRANS
MIDTRANS_CLIENT_KEY=SB-Mid-client-GANTI_DENGAN_CLIENT_KEY_MIDTRANS
# Set 'true' hanya untuk lingkungan Midtrans Production
MIDTRANS_PROD=false

# Simulasi pembayaran satu klik di halaman pembayaran: set 'true' HANYA untuk demo Sandbox (otomatis mati jika MIDTRANS_PROD=true)
ENABLE_PAYMENT_SIMULATION=false

# Set 'true' saat aplikasi berada di balik reverse proxy / ngrok agar ip_klien() dan deteksi HTTPS membaca header X-Forwarded-*
TRUSTED_PROXY=false

# Batas menit pesanan tunai berstatus menunggu_pembayaran sebelum dibatalkan otomatis oleh bin/kedaluwarsa.php
TUNAI_EXPIRY_MINUTES=60

# Batas maksimal percobaan checkout per IP klien dalam jendela 10 menit
CHECKOUT_RATE_MAX=10
